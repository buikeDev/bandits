// Prisma schema for BAND-IT platform
// Database: PostgreSQL
// Connection URL is configured in prisma.config.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model - registered users of the platform
model CustomerAccount {
  id           String            @id @default(cuid())
  email        String            @unique
  name         String
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sessions     CustomerSession[]
  orders       OrderEnquiry[]

  @@index([email])
}

model CustomerSession {
  id         String          @id @default(cuid())
  tokenHash  String          @unique
  customerId String
  customer   CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime        @default(now())

  @@index([customerId])
  @@index([expiresAt])
}

model StaffAccount {
  sessions     StaffSession[]
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  role         StaffRole      @default(STAFF)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([email])
  @@index([role, isActive])
}

enum StaffRole {
  ADMIN
  STAFF
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  description          String
  kind                 ProductKind           @default(WRISTBAND)
  basePrice            Decimal               @db.Decimal(12, 2)
  compareAtPrice       Decimal?              @db.Decimal(12, 2)
  imageUrl             String
  isFeatured           Boolean               @default(false)
  isActive             Boolean               @default(true)
  categoryId           String
  category             Category              @relation(fields: [categoryId], references: [id])
  brandId              String?
  brand                Brand?                @relation(fields: [brandId], references: [id])
  variants             ProductVariant[]
  pricingTiers         ProductPricingTier[]
  customizationOptions CustomizationOption[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([categoryId, isActive])
  @@index([kind, isActive])
  @@index([isFeatured, isActive])
}

model ProductVariant {
  id                     String     @id @default(cuid())
  productId              String
  product                Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                   String
  sku                    String     @unique
  color                  String?
  material               String?
  size                   String?
  priceAdjustment        Decimal    @default(0) @db.Decimal(12, 2)
  isCustomizationEnabled Boolean    @default(false)
  isActive               Boolean    @default(true)
  inventory              Inventory?
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([productId, isActive])
}

model Inventory {
  id               String         @id @default(cuid())
  variantId        String         @unique
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity         Int            @default(0)
  reservedQuantity Int            @default(0)
  updatedAt        DateTime       @updatedAt
}

model ProductPricingTier {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQuantity Int
  unitPrice   Decimal @db.Decimal(12, 2)

  @@unique([productId, minQuantity])
  @@index([productId])
}

model CustomizationOption {
  id              String            @id @default(cuid())
  productId       String
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type            CustomizationType
  name            String
  priceAdjustment Decimal           @default(0) @db.Decimal(12, 2)
  isRequired      Boolean           @default(false)

  @@index([productId])
}

enum ProductKind {
  WRISTBAND
  MARKETPLACE
}

enum CustomizationType {
  TEXT
  LOGO
  ARTWORK_UPLOAD
  COLOR
}

// Immutable enquiry snapshot. Opening WhatsApp is not proof of sending or payment.
model OrderEnquiry {
  workflow      OrderWorkflow?
  customerId    String?
  customer      CustomerAccount? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  id            String           @id @default(cuid())
  requestId     String           @unique
  requestHash   String
  reference     String           @unique
  status        String           @default("AWAITING_WHATSAPP")
  currency      String           @default("NGN")
  snapshot      Json
  message       String
  totalQuantity Int
  subtotalMinor BigInt
  quoteRequired Boolean
  createdAt     DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
}

model StaffSession {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  staffId   String
  staff     StaffAccount @relation(fields: [staffId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([staffId])
}

model OrderWorkflow {
  id              String             @id @default(cuid())
  orderId         String             @unique
  order           OrderEnquiry       @relation(fields: [orderId], references: [id])
  version         Int                @default(0)
  contactName     String             @default("")
  contactPhone    String             @default("")
  deliveryAddress String             @default("")
  deliveryMethod  String             @default("COLLECTION")
  tracking        String             @default("")
  acceptedQuoteId String?
  quotes          OrderQuote[]
  payments        OrderPayment[]
  events          OrderEvent[]
  reservations    StockReservation[]
  updatedAt       DateTime           @updatedAt
}

model OrderQuote {
  id            String        @id @default(cuid())
  workflowId    String
  workflow      OrderWorkflow @relation(fields: [workflowId], references: [id])
  lines         Json
  printingMinor BigInt
  deliveryMinor BigInt
  totalMinor    BigInt
  note          String
  staffId       String
  createdAt     DateTime      @default(now())

  @@index([workflowId, createdAt])
}

model OrderPayment {
  id          String        @id @default(cuid())
  workflowId  String
  workflow    OrderWorkflow @relation(fields: [workflowId], references: [id])
  amountMinor BigInt
  kind        String
  reference   String
  staffId     String
  createdAt   DateTime      @default(now())

  @@unique([workflowId, reference])
}

model OrderEvent {
  id         String        @id @default(cuid())
  workflowId String
  workflow   OrderWorkflow @relation(fields: [workflowId], references: [id])
  staffId    String
  staffName  String
  action     String
  note       String
  createdAt  DateTime      @default(now())

  @@index([workflowId, createdAt])
}

model StockReservation {
  id         String        @id @default(cuid())
  workflowId String
  workflow   OrderWorkflow @relation(fields: [workflowId], references: [id])
  variantId  String
  quantity   Int
  state      String        @default("RESERVED")

  @@unique([workflowId, variantId])
}

model AdminAudit {
  id        String   @id @default(cuid())
  staffId   String
  action    String
  targetId  String
  details   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

